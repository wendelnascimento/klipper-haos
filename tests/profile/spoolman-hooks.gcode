; Spoolman hooks in the filament macros (stand-ins from spoolman-hooks.cfg).
G28
; LOAD_FILAMENT opens the spool picker before any filament moves.
LOAD_FILAMENT TEMP=210
_TEST_ASSERT_HOOK NAME=SELECT COUNT=1 E=0
_TEST_ASSERT_HOOK NAME=EJECT COUNT=0
; UNLOAD_FILAMENT clears the spool after the filament is out (69 +5 -10 -50).
UNLOAD_FILAMENT
_TEST_ASSERT_HOOK NAME=EJECT COUNT=1 E=14
; Opting out.
UNLOAD_FILAMENT EJECT_SPOOL=0
_TEST_ASSERT_HOOK NAME=EJECT COUNT=1
LOAD_FILAMENT SELECT_SPOOL=0
_TEST_ASSERT_HOOK NAME=SELECT COUNT=1
; M600 unloads, so it clears the spool too.
M600
_TEST_ASSERT_HOOK NAME=EJECT COUNT=2
LOAD_FILAMENT
_TEST_ASSERT_HOOK NAME=SELECT COUNT=2
RESUME
M104 S0
M84
