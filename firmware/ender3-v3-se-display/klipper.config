# Klipper MCU firmware configuration (Kconfig fragment) for the
# Creality Ender 3 V3 SE WITH the original display (experimental).
#
# Same as firmware/ender3-v3-se/klipper.config, plus a serial bridge
# on USART2 (PA2/PA3), where the stock display cable is connected. The
# bridge lets the e3v3se_display module in the app talk to the display over
# the existing USB connection. Extra "make menuconfig" choices:
#   Enable extra low-level configuration options : yes
#   Enable serial bridge                         : yes
#   USART2                                       : yes
#
# The serial bridge sources are not part of upstream Klipper. They are added
# by tools/build-firmware.sh from the pinned fork commit (see the "overlay"
# file in this directory). VERIFY your board revision before flashing.
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32F103=y
CONFIG_STM32_FLASH_START_7000=y
CONFIG_STM32_SERIAL_USART1=y
CONFIG_SERIAL_BAUD=250000
CONFIG_LOW_LEVEL_OPTIONS=y
# Visible (and so checked) only with low-level options: same 8 MHz default.
CONFIG_STM32_CLOCK_REF_8M=y
CONFIG_SERIAL_BRIDGE=y
CONFIG_ENABLE_SERIAL_BRIDGE_USART2=y
