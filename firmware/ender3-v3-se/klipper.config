# Klipper MCU firmware configuration (Kconfig fragment) for the
# Creality Ender 3 V3 SE, board CR4NS200320C13 (GD32F303RET6 MCU).
#
# Equivalent "make menuconfig" choices:
#   Micro-controller Architecture : STMicroelectronics STM32
#   Processor model               : STM32F103
#   Bootloader offset             : 28KiB bootloader
#   Clock Reference               : 8 MHz crystal
#   Communication interface       : Serial (on USART1 PA10/PA9)
#   Baud rate                     : 250000
#
# USART1 is wired to the board's USB-to-serial chip (USB-C connector).
# Expanded to a full .config with "make olddefconfig" by
# tools/build-firmware.sh. VERIFY your board revision before flashing.
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32F103=y
CONFIG_STM32_FLASH_START_7000=y
CONFIG_STM32_CLOCK_REF_8M=y
CONFIG_STM32_SERIAL_USART1=y
CONFIG_SERIAL_BAUD=250000
